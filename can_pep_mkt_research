const fmtUSD = n => '$' + (n/1e6).toFixed(1) + 'M';
const fmtCAD = n => n == null ? 'suppressed / n.a.' : 'C$' + (n/1e6).toFixed(1) + 'M';
const fmtT = n => n == null ? 'n.a.' : Number(n).toLocaleString(undefined,{maximumFractionDigits:0}) + ' t';
const fmtHa = n => n == null ? 'n.a.' : Number(n).toLocaleString(undefined,{maximumFractionDigits:1}) + ' ha';
const esc = s => String(s ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const plotCfg = {responsive:true, displaylogo:false, modeBarButtonsToAdd:['toImage'], toImageButtonOptions:{format:'png', filename:'canada_pepper_dashboard', height:900, width:1400, scale:2}};
const layoutBase = {paper_bgcolor:'#fff', plot_bgcolor:'#fff', font:{family:'-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif', color:'#1C2430'}, margin:{t:50,l:70,r:35,b:80}, colorway:['#0E7C7B','#F18F01','#174A7C','#BC4749','#7C3AED','#0F766E'], hoverlabel:{bgcolor:'#0B1F33', font:{color:'#fff'}}};

function initHeader(){
  const m = DATA.metadata;
  document.getElementById('headerPills').innerHTML = [m.crop, m.geography, 'FY ' + m.fiscal_period, 'Confidence ' + m.confidence_score + '/10'].map(x=>`<span class="pill">${esc(x)}</span>`).join('');
  document.getElementById('thesis').textContent = DATA.executive_summary.thesis;
}
function initCards(){
  const ms = DATA.market_sizing, p = DATA.production, t = DATA.trade_and_demand;
  const cards = [
    ['Seed TAM', fmtUSD(ms.fy2026_2027_tam_usd), 'Full Canadian pepper seed value pool, FY2026–FY2027'],
    ['SAM', fmtUSD(ms.fy2026_2027_sam_usd), 'Serviceable commercial hybrid / premium hybrid pool'],
    ['SOM', fmtUSD(ms.fy2026_2027_som_usd), 'Near-term obtainable value at 5% of SAM'],
    ['2024 Trade Surplus', fmtUSD(t.trade_surplus_2024_usd), 'HS070960 fresh/chilled Capsicum or Pimenta'],
    ['2025 GH Production', fmtT(p.greenhouse_annual.at(-1).production_tonnes), 'Greenhouse peppers in Canada'],
    ['2025 Field Production', fmtT(p.field_annual.at(-1).production_tonnes), 'Open-field peppers in Canada'],
    ['GH Farm Gate', fmtCAD(p.greenhouse_annual.at(-1).farm_gate_value_cad), '2025 greenhouse pepper value'],
    ['Field Farm Gate', fmtCAD(p.field_annual.at(-1).farm_gate_value_cad), '2025 field pepper value']
  ];
  document.getElementById('summary').innerHTML = cards.map(c=>`<article class="card"><div class="label">${esc(c[0])}</div><div class="value">${esc(c[1])}</div><div class="note">${esc(c[2])}</div></article>`).join('');
}
function drawSizing(){
  const a = DATA.seed_assumptions;
  document.getElementById('assumptionsTable').innerHTML = '<thead><tr><th>Assumption</th><th>Value</th></tr></thead><tbody>' + Object.entries(a).map(([k,v])=>`<tr><td>${esc(k.replaceAll('_',' '))}</td><td><b>${esc(typeof v==='number' ? Number(v).toLocaleString(undefined,{maximumFractionDigits:4}) : v)}</b></td></tr>`).join('') + '</tbody>';
}
function drawProduction(){
  const gh = DATA.production.greenhouse_annual, f = DATA.production.field_annual;
  const years = gh.map(x=>x.year);
  Plotly.newPlot('productionChart', [{type:'bar', name:'Greenhouse', x:years, y:gh.map(x=>x.production_tonnes), marker:{color:'#0E7C7B'}},{type:'bar', name:'Field', x:years, y:f.map(x=>x.production_tonnes), marker:{color:'#F18F01'}}], {...layoutBase, barmode:'group', yaxis:{title:'Tonnes'}, title:'Production volume by system'}, plotCfg);
  Plotly.newPlot('valueChart', [{type:'scatter', mode:'lines+markers', name:'Greenhouse', x:years, y:gh.map(x=>x.farm_gate_value_cad/1e6), line:{width:4,color:'#0E7C7B'}},{type:'scatter', mode:'lines+markers', name:'Field', x:years, y:f.map(x=>x.farm_gate_value_cad/1e6), line:{width:4,color:'#F18F01'}}], {...layoutBase, yaxis:{title:'C$M'}, title:'Farm-gate value trend'}, plotCfg);
  Plotly.newPlot('yieldChart', [{type:'bar', x:['Greenhouse 3-year avg','Field 3-year avg'], y:[DATA.production.greenhouse_2023_2025_avg.yield_tonnes_per_ha, DATA.production.field_2023_2025_avg.yield_tonnes_per_ha], text:[DATA.production.greenhouse_2023_2025_avg.yield_tonnes_per_ha.toFixed(1)+' t/ha', DATA.production.field_2023_2025_avg.yield_tonnes_per_ha.toFixed(1)+' t/ha'], textposition:'outside', marker:{color:['#0E7C7B','#F18F01']}}], {...layoutBase, yaxis:{title:'t/ha'}, title:'Yield intensity gap'}, plotCfg);
  const avg = DATA.production;
  document.getElementById('productionStats').innerHTML = [
    ['GH avg area', fmtHa(avg.greenhouse_2023_2025_avg.area_ha), 'Harvested equivalent'],
    ['Field avg area', fmtHa(avg.field_2023_2025_avg.planted_ha), 'Planted hectares'],
    ['GH avg value', fmtCAD(avg.greenhouse_2023_2025_avg.farm_gate_value_cad), '2023–2025 average']
  ].map(x=>`<div class="mini"><div class="label">${x[0]}</div><div class="big">${x[1]}</div><p class="note">${x[2]}</p></div>`).join('');
}
function drawRegions(){
  const r = DATA.production.regional_2025;
  Plotly.newPlot('regionalChart', [{type:'bar', name:'Greenhouse', x:r.map(x=>x.region), y:r.map(x=>x.greenhouse_production_tonnes_2025 || 0), marker:{color:'#0E7C7B'}},{type:'bar', name:'Field', x:r.map(x=>x.region), y:r.map(x=>x.field_production_tonnes_2025 || 0), marker:{color:'#F18F01'}}], {...layoutBase, barmode:'stack', yaxis:{title:'Tonnes'}, title:'2025 production by region'}, plotCfg);
  document.getElementById('climateCards').innerHTML = DATA.production_regions_climate_twins.map(c=>`<details open><summary>${esc(c.region)}</summary><p><b>Climate signal:</b> ${esc(c.climate_signal)}</p><p><b>Twins:</b> ${c.climate_twins.map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</p><p><b>Seed implication:</b> ${esc(c.seed_implication)}</p></details>`).join('');
}
function drawTrade(){
  const t = DATA.trade_and_demand;
  Plotly.newPlot('tradeChart', [{type:'bar', x:['Imports','Exports','Trade surplus'], y:[t.imports_2024_usd, t.exports_2024_usd, t.trade_surplus_2024_usd], text:[fmtUSD(t.imports_2024_usd), fmtUSD(t.exports_2024_usd), fmtUSD(t.trade_surplus_2024_usd)], textposition:'outside', marker:{color:['#BC4749','#0E7C7B','#174A7C']}, customdata:[[t.imports_2024_kg],[t.exports_2024_kg],[t.net_export_volume_2024_kg]], hovertemplate:'%{x}<br>Value: %{text}<br>Volume: %{customdata[0]:,.0f} kg<extra></extra>'}], {...layoutBase, yaxis:{title:'USD'}, title:'HS070960 fresh/chilled pepper trade'}, plotCfg);
  const tbl = (title, arr) => `<h3>${esc(title)}</h3><div class="scroll"><table><thead><tr><th>Partner</th><th>Value</th><th>Volume</th></tr></thead><tbody>${arr.map(x=>`<tr><td>${esc(x.partner)}</td><td>${fmtUSD(x.value_usd)}</td><td>${(x.kg/1e6).toFixed(1)}M kg</td></tr>`).join('')}</tbody></table></div>`;
  document.getElementById('tradeTables').innerHTML = `<p><b>Apparent fresh supply proxy:</b> ${(t.apparent_fresh_supply_2024_kg/1e6).toFixed(1)}M kg</p>` + tbl('Top importers from Canada', t.mirror_importers_from_canada_2024) + tbl('Top exporters to Canada', t.top_exporters_to_canada_2024);
}
function drawTrends(){
  const trends = DATA.trends.slice().sort((a,b)=>b.score-a.score);
  document.getElementById('trendTable').innerHTML = '<thead><tr><th>Rank</th><th>Category</th><th>Trend</th><th>Impact</th><th>Velocity</th><th>Score</th><th>Seed-market implication</th></tr></thead><tbody>' + trends.map((t,i)=>{ const cls = t.score>=27 ? 'tag' : (t.score>=20 ? 'tag warn-tag' : 'tag'); return `<tr><td><b>${i+1}</b></td><td>${esc(t.category)}</td><td>${esc(t.trend)}</td><td>${t.impact_score}/10</td><td>${esc(t.velocity)}</td><td><span class="${cls}">${t.score}</span></td><td>${esc(t.seed_implication)}</td></tr>`; }).join('') + '</tbody>';
}
function drawSegments(){
  document.getElementById('segmentCards').innerHTML = DATA.typology_segments.map((s,i)=>`<details ${i<2?'open':''}><summary>${esc(s.segment)}</summary><p><b>System:</b> ${esc(s.systems)}</p><p><b>Variety types:</b> ${esc(s.variety_types)}</p><p><b>Buyer need:</b> ${esc(s.buyer_need)}</p><p><b>Seed traits:</b> ${esc(s.desired_traits)}</p></details>`).join('');
}
function drawDisease(){
  const ds = DATA.disease_trait_priorities;
  const filters = ['All','Greenhouse','Field'];
  document.getElementById('diseaseBtns').innerHTML = filters.map((f,i)=>`<button class="btn ${i===0?'active':''}" onclick="filterDisease('${f}', this)">${f}</button>`).join('');
  window._disease = ds; filterDisease('All', document.querySelector('#diseaseBtns .btn'));
}
function filterDisease(filter, el){
  document.querySelectorAll('#diseaseBtns .btn').forEach(b=>b.classList.remove('active')); if(el) el.classList.add('active');
  const filtered = window._disease.filter(d => filter==='All' || d.main_segment.toLowerCase().includes(filter.toLowerCase()));
  document.getElementById('diseaseCards').innerHTML = filtered.map(d=>`<div class="mini"><div class="label">${esc(d.main_segment)}</div><h3>${esc(d.disease_or_pressure)}</h3><p>${esc(d.evidence)}</p><p><b>Desired trait:</b> ${esc(d.desired_trait)}</p></div>`).join('');
}
function drawStrategy(){
  document.getElementById('recommendations').innerHTML = DATA.strategic_recommendations.map(r=>`<li>${esc(r)}</li>`).join('');
  document.getElementById('limitations').innerHTML = `<div class="big">${DATA.metadata.confidence_score}/10 confidence</div><ul>${DATA.limitations.map(l=>`<li>${esc(l)}</li>`).join('')}</ul>`;
  document.getElementById('sourcesList').innerHTML = DATA.sources.map(s=>`<li><a href="${esc(s.url)}" target="_blank" rel="noopener"><b>${esc(s.name)}</b></a><br><span class="note">${esc(s.use)}</span></li>`).join('');
}
function init(){initHeader(); initCards(); drawSizing(); drawProduction(); drawRegions(); drawTrade(); drawTrends(); drawSegments(); drawDisease(); drawStrategy();}
window.addEventListener('load', init);
</script>
